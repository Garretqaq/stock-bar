{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主面板、设置窗口与 Windows 悬浮行情条权限",
  "windows": ["main", "settings", "ticker"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "positioner:default",
    "notification:default"
  ]
}
